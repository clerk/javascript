        "packages/*/tsdown.config.*",
        "packages/*/tsup.config.*",
        "packages/*/rspack.config.*",
        "packages/*/vite.config.*",
        "!packages/*/src/**/*.test.*",
        "!packages/*/src/**/__tests__/**",
        "!packages/*/src/**/__mocks__/**",
        "!packages/*/src/**/__snapshots__/**"
