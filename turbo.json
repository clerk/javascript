{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "remoteCache": {
    "signature": true
  },
  "ui": "tui",
  "globalDependencies": [
    ".github/.cache-version",
    ".npmrc",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "tsconfig.*.json"
  ],
  "globalEnv": [
    "CLERK_*",
    "EXPO_PUBLIC_CLERK_*",
    "NEXT_PHASE",
    "NEXT_PUBLIC_CLERK_*",
    "NODE_ENV",
    "NODE_VERSION",
    "NPM_VERSION",
    "PLASMO_PUBLIC_CLERK_*",
    "PUBLIC_CLERK_*",
    "REACT_APP_CLERK_*",
    "RSDOCTOR",
    "TZ",
    "VERCEL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_TARGET_ENV",
    "VITE_CLERK_*",
    "!CLERK_E2E_OAUTH_PROVIDER_CLIENT_SECRET",
    "!CLERK_PLATFORM_API_KEY"
  ],
  "globalPassThroughEnv": [
    "AWS_SECRET_KEY",
    "CLERK_E2E_OAUTH_PROVIDER_CLIENT_SECRET",
    "CLERK_PLATFORM_API_KEY",
    "GITHUB_TOKEN",
    "INTEGRATION_TEST_RUN_KEY",
    "ACTIONS_RUNNER_DEBUG",
    "ACTIONS_STEP_DEBUG",
    "VERCEL_AUTOMATION_BYPASS_SECRET",
    "PORT",
    "UI_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "*.d.ts",
        "bundlewatch.config.json",
        "src/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.declarations.json",
        "tsdown.config.mts",
        "tsdown.config.ts",
        "tsup.config.ts",
        "vite.config.*",
        "subpaths.mjs",
        "!**/*.test.*",
        "!**/test/**",
        "!**/tests/**",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!**/__snapshots__/**",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "!examples/**",
        "!node_modules/**"
      ],
      "outputLogs": "new-only",
      "outputs": ["*/package.json", "dist/**", "scripts/**"]
    },
    "build:declarations": {
      "dependsOn": ["build"],
      "inputs": ["tsconfig.declarations.json"],
      "outputLogs": "new-only",
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "dev": {
      "cache": false
    },
    "@clerk/clerk-js#dev": {
      "cache": false,
      "dependsOn": ["@clerk/shared#build"]
    },
    "@clerk/ui#dev": {
      "cache": false,
      "dependsOn": ["@clerk/shared#build", "@clerk/localizations#build"]
    },
    "@clerk/shared#dev": {
      "cache": false,
      "dependsOn": ["@clerk/shared#build"]
    },
    "@clerk/localizations#dev": {
      "cache": false,
      "dependsOn": ["@clerk/localizations#build"]
    },
    "dev:current": {
      "cache": false,
      "dependsOn": ["^build", "dev"],
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "*.d.ts",
        "bundlewatch.config.json",
        "src/**",
        "tests/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "tsdown.config.mts",
        "tsdown.config.ts",
        "tsup.config.ts",
        "!**/__snapshots__/**",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "!examples/**",
        "!node_modules/**"
      ],
      "outputLogs": "new-only",
      "outputs": []
    },
    "test:cache:clear": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/oxlint.config.mjs",
        "$TURBO_ROOT$/scripts/oxlint-*.mjs",
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.md",
        "**/*.mdx",
        ".github/**",
        "!*/package.json",
        "!**/__snapshots__/**",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "!examples/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "lint:publint": {
      "dependsOn": ["build"],
      "inputs": ["dist/**", "package.json"],
      "outputs": []
    },
    "lint:attw": {
      "dependsOn": ["build"],
      "inputs": ["dist/**", "package.json"],
      "outputs": []
    },
    "bundlewatch": {
      "dependsOn": ["build"],
      "env": [
        "BUNDLEWATCH_GITHUB_TOKEN",
        "CI_BRANCH",
        "CI_BRANCH_BASE",
        "CI_REPO_NAME",
        "CI_REPO_OWNER",
        "CI_COMMIT_SHA"
      ],
      "outputs": []
    },
    "format": {
      "inputs": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.md",
        "**/*.mdx",
        "**/*.vue",
        "**/*.astro",
        "**/*.css",
        "**/*.scss",
        "**/*.html",
        ".prettierignore",
        "prettier.config.mjs",
        "!**/__snapshots__/**",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "!examples/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "format:check": {
      "inputs": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "**/*.json",
        "**/*.md",
        "**/*.mdx",
        "**/*.vue",
        "**/*.astro",
        "**/*.css",
        "**/*.scss",
        "**/*.html",
        ".prettierignore",
        "prettier.config.mjs",
        "!**/__snapshots__/**",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "!examples/**",
        "!node_modules/**"
      ],
      "outputs": []
    },
    "//#test:integration:ap-flows": {
      "env": [
        "CLEANUP",
        "CLERK_E2E_OAUTH_PROVIDER_CLIENT_SECRET",
        "CLERK_PLATFORM_API_KEY",
