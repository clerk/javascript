{
  "expo": {
    "name": "Clerk Kotlin Alignment",
    "slug": "clerk-kotlin-alignment",
    "version": "1.0.0",
    "android": {
      "package": "com.clerk.expo.kotlin_alignment"
    },
    "plugins": [
      "@clerk/expo",
      [
        "expo-build-properties",
        {
          "android": {
