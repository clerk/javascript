{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/clerk-js/package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "**/__test__/**",
        "*.d.ts",
        "src/**",
        "vitest.config.mts",
        "vitest.setup.mts",
        "tsconfig.json",
        "tsconfig.*.json",
        "tsup.config.ts",
        "!**/__snapshots__/**",
        "!CHANGELOG.md",
        "!coverage/**",
        "!dist/**",
        "!examples/**",
        "!node_modules/**"
      ],
      "outputLogs": "new-only",
      "outputs": []
    }
  }
}
