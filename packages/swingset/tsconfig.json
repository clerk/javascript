{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@clerk/mosaic": ["../mosaic/src"],
      "@clerk/mosaic/*": ["../mosaic/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true
  },
  "include": ["mdx-components.tsx", "next.config.mjs", "src", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
