{
  "compilerOptions": {
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "module": "preserve",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "paths": {
      // Test-only; tsserver stays in-package. vitest.config.mts aliases these to clerk-js at runtime.
      "@/core/*": ["./src/test/core-shims/*"],
      "@/*": ["./src/*"],
      // Adding this to avoid changes in the ui files
      // in order to make git merges easier
      // TODO: @nikos remove after v6 release
      "@/ui*": ["./src/*"]
    }
  }
}
