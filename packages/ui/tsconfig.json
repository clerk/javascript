{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "preserveWatchOutput": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "types": ["@rspack/core/module"]
  },
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "./src/test/**"
  ],
  "include": ["src", "src/global.d.ts"],
  "references": [{ "path": "./tsconfig.test.json" }]
}
