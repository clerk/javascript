{
  "name": "@clerk/mosaic",
  "version": "0.2.2",
  "description": "Clerk Mosaic UI components",
  "keywords": [
    "clerk",
    "auth",
    "authentication",
    "react",
    "mosaic",
    "ui"
  ],
  "homepage": "https://clerk.com/",
  "bugs": {
    "url": "https://github.com/clerk/javascript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clerk/javascript.git",
    "directory": "packages/mosaic"
  },
  "license": "MIT",
  "author": "Clerk",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/avatar": {
      "types": "./dist/components/avatar.d.ts",
      "import": "./dist/components/avatar.js",
      "default": "./dist/components/avatar.js"
    },
    "./components/badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js",
      "default": "./dist/components/badge.js"
    },
    "./components/banner": {
      "types": "./dist/components/banner.d.ts",
      "import": "./dist/components/banner.js",
      "default": "./dist/components/banner.js"
    },
    "./components/button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js",
      "default": "./dist/components/button.js"
    },
    "./components/data-list": {
      "types": "./dist/components/data-list.d.ts",
      "import": "./dist/components/data-list.js",
      "default": "./dist/components/data-list.js"
    },
    "./components/empty-state": {
      "types": "./dist/components/empty-state.d.ts",
      "import": "./dist/components/empty-state.js",
      "default": "./dist/components/empty-state.js"
    },
    "./components/entity": {
      "types": "./dist/components/entity.d.ts",
      "import": "./dist/components/entity.js",
      "default": "./dist/components/entity.js"
    },
    "./components/heading": {
      "types": "./dist/components/heading.d.ts",
      "import": "./dist/components/heading.js",
      "default": "./dist/components/heading.js"
    },
    "./components/icon": {
      "types": "./dist/components/icon.d.ts",
      "import": "./dist/components/icon.js",
      "default": "./dist/components/icon.js"
    },
    "./components/input": {
      "types": "./dist/components/input.d.ts",
      "import": "./dist/components/input.js",
      "default": "./dist/components/input.js"
    },
    "./components/item": {
      "types": "./dist/components/item.d.ts",
      "import": "./dist/components/item.js",
      "default": "./dist/components/item.js"
    },
    "./components/skeleton": {
      "types": "./dist/components/skeleton.d.ts",
      "import": "./dist/components/skeleton.js",
      "default": "./dist/components/skeleton.js"
    },
    "./components/table": {
      "types": "./dist/components/table.d.ts",
      "import": "./dist/components/table.js",
      "default": "./dist/components/table.js"
    },
    "./components/text": {
      "types": "./dist/components/text.d.ts",
      "import": "./dist/components/text.js",
      "default": "./dist/components/text.js"
    },
    "./icons/glyphs/external": {
      "types": "./dist/icons/glyphs/external.d.ts",
      "import": "./dist/icons/glyphs/external.js",
      "default": "./dist/icons/glyphs/external.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.d.mts.map",
    "styles.css.d.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm build:js && pnpm build:css && pnpm check:bundle && pnpm typecheck",
    "build:css": "tsdown --config tsdown.css.config.mts",
    "build:js": "tsdown --config tsdown.config.mts",
    "bundlewatch": "FORCE_COLOR=1 bundlewatch --config bundlewatch.config.json",
    "check:bundle": "node ./scripts/check-bundle.mjs",
    "clean": "rimraf ./dist ./dist-css",
    "dev": "tsdown --config tsdown.config.mts --watch",
    "format": "node ../../scripts/format-package.mjs",
    "format:check": "node ../../scripts/format-package.mjs --check",
    "lint": "oxlint -c oxlint.config.mjs src",
    "lint:attw": "attw --pack . --exclude-entrypoints styles.css --profile esm-only",
    "lint:publint": "publint",
    "test": "vitest run --project primitives --project mosaic",
    "test:browser": "vitest run --project browser",
    "test:ci": "vitest run --project primitives --project mosaic --maxWorkers=70%",
    "test:feature": "vitest run --project feature",
    "test:visual": "bash ./scripts/test-visual.sh compare",
    "test:visual:update": "bash ./scripts/test-visual.sh update",
    "test:webkit": "vitest run --project webkit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/shared": "workspace:^",
    "@floating-ui/react": "catalog:repo",
    "@wallet-standard/core": "catalog:module-manager"
  },
  "devDependencies": {
    "@clerk/clerk-js": "workspace:^",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/rollup-plugin": "0.19.0",
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "axe-core": "^4.11.3",
    "bundlewatch": "^0.4.2",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "happy-dom": "^20.8.9",
    "msw": "2.15.0",
    "playwright": "1.62.1",
    "qrcode.react": "4.2.0",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tsdown": "catalog:repo",
    "typescript": "7.0.2",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": "catalog:peer-react",
    "react-dom": "catalog:peer-react"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
