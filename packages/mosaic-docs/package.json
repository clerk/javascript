{
  "name": "@clerk/mosaic-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate && next build",
    "dev": "pnpm generate && next dev --port 6021",
    "format": "node ../../scripts/format-package.mjs",
    "format:check": "node ../../scripts/format-package.mjs --check",
    "generate": "node scripts/generate-docs.mjs",
    "lint": "oxlint -c ../../oxlint.config.mjs src scripts",
    "test": "node --test 'scripts/*.test.mjs' 'src/**/*.test.ts'",
    "typecheck": "pnpm generate && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/mosaic": "workspace:*",
    "next": "^16.4.3",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "tailwindcss": "^4.3.0",
    "typescript": "catalog:repo"
  }
}
