{
  "name": "@clerk/mosaic-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate.mts",
    "build": "next build",
    "predev": "node scripts/generate.mts",
    "dev": "next dev --port 6021",
    "format": "node ../../scripts/format-package.mjs",
    "format:check": "node ../../scripts/format-package.mjs --check",
    "generate": "node scripts/generate.mts",
    "lint": "oxlint -c ../../oxlint.config.mjs src scripts",
    "typecheck": "node scripts/generate.mts && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdx": "^2.0.13",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "prettier": "3.8.3",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:repo"
  }
}
